{
  "name": "slothsort",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "node scripts/generate-dummy-files.js && BROWSERSLIST_IGNORE_OLD_DATA=true ./node_modules/.bin/tailwindcss -i ./app/input.css -o ./app/globals.css >/dev/null 2>&1 && next dev --webpack",
    "build": "node scripts/generate-dummy-files.js && BROWSERSLIST_IGNORE_OLD_DATA=true ./node_modules/.bin/tailwindcss -i ./app/input.css -o ./app/globals.css --minify >/dev/null 2>&1 && next build --webpack",
    "start": "next start",
    "seed": "node scripts/generate-dummy-files.js"
  },
  "dependencies": {
    "@mastra/core": "^1.79.0",
    "@sentry/nextjs": "^11.9.0",
    "lucide-react": "^1.14.0",
    "next": "^16.2.4",
    "react": "^19.2.5",
    "react-dom": "^19.2.5"
  },
  "devDependencies": {
    "@types/node": "^22.0.0",
    "@types/react": "^19.0.0",
    "@types/react-dom": "^19.0.0",
    "autoprefixer": "^10.4.20",
    "postcss": "^8.4.49",
    "tailwindcss": "^3.4.17",
    "typescript": "^5.7.0"
  }
}
